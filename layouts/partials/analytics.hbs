{{#if site.googleAnalyticsMeasurementId}}
<script async src="https://www.googletagmanager.com/gtag/js?id={{site.googleAnalyticsMeasurementId}}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', '{{site.googleAnalyticsMeasurementId}}');
</script>
{{/if}}
